{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heritage-short/schema/storyboard.schema.json",
  "title": "Storyboard",
  "description": "The contract between every pipeline stage. Each stage reads this file and writes only its own outputs.",
  "type": "object",
  "required": ["title", "logline", "audience", "intent", "language", "style", "characters", "voice", "music", "shots", "end_card"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "logline": {"type": "string", "minLength": 1, "description": "One sentence that sums up the story."},
    "audience": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1, "description": "What the audience should feel or understand at the end."},
    "language": {
      "type": "object",
      "required": ["narration", "subtitles"],
      "additionalProperties": false,
      "properties": {
        "narration": {"type": "string", "description": "BCP-47 code, e.g. ar-SA"},
        "subtitles": {"type": "string", "description": "BCP-47 code, e.g. en"}
      }
    },
    "style": {
      "type": "object",
      "required": ["block"],
      "additionalProperties": false,
      "properties": {
        "block": {"type": "string", "minLength": 10, "description": "Style text appended to every image prompt (palette, light, medium)."},
        "negative": {"type": "string"}
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string", "minLength": 10, "description": "Fixed appearance text, attached to every prompt that features this character."},
          "real_person": {"type": "boolean", "default": false, "description": "True if this depicts a real person: requires a consent record in ETHICS.md."}
        }
      }
    },
    "voice": {
      "type": "object",
      "required": ["name", "style"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "description": "Gemini TTS prebuilt voice name, e.g. Charon"},
        "style": {"type": "string", "description": "Plain-language delivery instruction, e.g. warm, slow, reflective"}
      }
    },
    "music": {
      "type": "object",
      "required": ["caption", "bpm", "cues"],
      "additionalProperties": false,
      "properties": {
        "caption": {"type": "string", "minLength": 10, "description": "ACE-Step caption: style, mood, instruments, texture."},
        "bpm": {"type": "integer", "minimum": 40, "maximum": 200},
        "key": {"type": "string"},
        "seed": {"type": "integer"},
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["at_shot", "does"],
            "additionalProperties": false,
            "properties": {
              "at_shot": {"type": "string"},
              "does": {"type": "string", "description": "What the music does here: enters, builds, drops out, returns."}
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 6,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["id", "duration", "reason", "shot_size", "image_prompt", "motion_prompt", "narration", "subtitle"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
          "duration": {"type": "number", "minimum": 3, "maximum": 12, "description": "Seconds on screen. Assembly extends it if narration is longer."},
          "reason": {"type": "string", "minLength": 5, "description": "Why this shot exists in the story."},
          "shot_size": {"type": "string", "enum": ["extreme_wide", "wide", "medium", "medium_close", "close", "extreme_close", "insert"]},
          "characters": {"type": "array", "items": {"type": "string"}},
          "image_prompt": {"type": "string", "minLength": 10, "description": "What the still shows. Style block and character text are added automatically."},
          "motion_prompt": {"type": "string", "minLength": 3, "description": "Only the motion and camera (for image-to-video)."},
          "kenburns": {"type": "string", "enum": ["in", "out", "left", "right", "up", "down"], "default": "in", "description": "Fallback pan/zoom direction when no video clip exists."},
          "transition_in": {"type": "string", "enum": ["cut", "dip"], "default": "cut", "description": "How this shot begins: a hard cut, or a short dip to black (for a jump in time)."},
          "narration": {"type": "string", "description": "Spoken line in the narration language (may be empty for a music-only beat)."},
          "subtitle": {"type": "string", "description": "English subtitle for the line."},
          "seed": {"type": "integer"}
        }
      }
    },
    "end_card": {
      "type": "object",
      "required": ["lines"],
      "additionalProperties": false,
      "properties": {
        "lines": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "duration": {"type": "number", "minimum": 2, "maximum": 6, "default": 3}
      }
    }
  }
}
