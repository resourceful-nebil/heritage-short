# Copy this file to .env and fill in your own values. .env is git-ignored: never commit keys.

# Google AI Studio -> Get API key (storyboard drafting + narration TTS)
GEMINI_API_KEY=

# Optional overrides; `python -m pipeline smoke` prints the models your key can use
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Cloudflare dashboard -> Account ID ; My Profile -> API Tokens -> "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Kaggle -> Settings -> API -> Create New Token (only needed if you use the Kaggle CLI)
KAGGLE_USERNAME=
KAGGLE_KEY=
